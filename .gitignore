# tooling / platform scratch — never commit
.tmp/
node_modules/
*.log

# editor / OS noise
.DS_Store
Thumbs.db
# Obsidian: track vault config, ignore per-machine UI state
**/.obsidian/workspace*.json
**/.obsidian/cache
.vscode/
.idea/

# test output
coverage/
*.tap
__pycache__/
*.pyc

# Generated from Minecraft's own assets at build time (scripts/mc-icons.py).
# Never committed: Mojang assets are not redistributable (see src/assets/icons/PROVENANCE.md).
src/assets/icons/*.png

# Panorama generated from the local game (scripts/mc-backdrop.py); never committed.
src/assets/panorama/*.webp
src/assets/panorama/*.png
src/assets/panorama/*.jpg

